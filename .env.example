# LogSight environment configuration.
# Copy to `.env` and adjust values:  cp .env.example .env
# Never commit a real `.env` file.

# PostgreSQL
POSTGRES_USER=logsight
POSTGRES_PASSWORD=logsight
POSTGRES_DB=logsight

# Backend (FastAPI)
# Inside Docker Compose the host must be `db`. For local dev use `localhost`.
DATABASE_URL=postgresql+psycopg://logsight:logsight@db:5432/logsight
BACKEND_PORT=8000

# Upload limits (megabytes)
MAX_UPLOAD_MB=1024

# Frontend
FRONTEND_PORT=8080
# Base URL the browser uses to reach the API. Default: same origin (/api proxied by nginx).
VITE_API_BASE_URL=
